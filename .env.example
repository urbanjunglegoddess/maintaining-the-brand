# Copy to .env.local and fill in as you connect each service.
# The app runs with this file entirely blank — see docs/CONNECTING.md.
#
# .env.local is gitignored. Never commit real keys.

# ── Supabase — accounts + synced answers ────────────────────────────────────
# Without these: no sign-in, answers save in the reader's browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Server-only. Bypasses all RLS.

# ── Stripe — selling it ─────────────────────────────────────────────────────
# Without these: nothing is locked, the whole book is readable.
# Needs Supabase configured first — gating requires accounts to gate against.
STRIPE_SECRET_KEY=                    # SECRET
STRIPE_PRICE_ID=                      # the one-time price for the workbook
STRIPE_WEBHOOK_SECRET=                # SECRET. The webhook is what grants access.

# ── App ─────────────────────────────────────────────────────────────────────
# Stripe's success/cancel URLs and the auth redirect are built from this.
# Set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email receipts (optional, later) ────────────────────────────────────────
RESEND_API_KEY=
